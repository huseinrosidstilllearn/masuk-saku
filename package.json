{
  "name": "masuk-saku",
  "description": "Web app open source untuk manajemen keuangan pribadi dan keluarga dengan AI OpenRouter BYOK.",
  "homepage": "https://masuksaku.my.id",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/huseinrosidstilllearn/masuk-saku.git"
  },
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build",
    "test:e2e": "playwright test",
    "test:auth": "playwright test --config playwright.auth.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:demo": "vite --host 127.0.0.1 --mode demo",
    "build:demo": "tsc -b && vite build --mode demo",
    "build:development": "tsc -b && vite build --mode development"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@supabase/supabase-js": "2.117.2",
    "lucide-react": "1.48.0",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
